{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XTalk",
  "version": "0.1.0",
  "identifier": "com.xtalk.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "XTalk",
        "width": 1200,
        "height": 800,
        "minWidth": 840,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "capabilities": [
        "main"
      ],
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*; frame-src http://127.0.0.1:*; img-src 'self' data: blob:; media-src 'self' blob:; script-src 'self'; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "devCsp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:* http://localhost:1420 ws://localhost:1420; frame-src http://127.0.0.1:*; img-src 'self' data: blob:; media-src 'self' blob:; script-src 'self'; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/app-backend",
      "binaries/local-model-runtime",
      "binaries/matcha-model-runtime",
      "binaries/mlx-model-runtime",
      "binaries/sherpa-onnx-offline-websocket-server"
    ],
    "resources": {
      "../resources/licenses/silero-vad-LICENSE.txt": "licenses/silero-vad-LICENSE.txt",
      "../resources/licenses/mlx-audio-swift-LICENSE.txt": "licenses/mlx-audio-swift-LICENSE.txt",
      "../resources/licenses/mlx-swift-LICENSE.txt": "licenses/mlx-swift-LICENSE.txt",
      "../resources/manifests/managed-models.lock.json": "manifests/managed-models.lock.json",
      "../resources/tools/": "tools/",
      "../resources/managed-runtime/ort/": "managed-runtime/ort/",
      "../resources/managed-runtime/mlx-swift_Cmlx.bundle/": "mlx-swift_Cmlx.bundle/",
      "../resources/models/audio/silero_vad.onnx": "models/audio/silero_vad.onnx",
      "binaries/app-backend-runtime/": "app-backend-runtime/"
    },
    "macOS": {
      "entitlements": "Entitlements.plist",
      "files": {
        "Frameworks": "binaries/app-backend-runtime"
      }
    },
    "linux": {
      "appimage": {
        "files": {
          "/usr/bin/app-backend-runtime": "binaries/app-backend-runtime"
        }
      },
      "deb": {
        "files": {
          "/usr/bin/app-backend-runtime": "binaries/app-backend-runtime"
        }
      },
      "rpm": {
        "files": {
          "/usr/bin/app-backend-runtime": "binaries/app-backend-runtime"
        }
      }
    }
  },
  "plugins": {}
}
