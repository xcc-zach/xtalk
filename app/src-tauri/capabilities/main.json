{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Allows the main XTalk window to configure and control its managed backend.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-apply-model-config",
    "allow-get-backend-connection",
    "allow-get-model-config-selection",
    "allow-shutdown-backend",
    "dialog:allow-open"
  ]
}
