{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Allows the main XTalk window to configure and control its managed backend.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-apply-tool-changes",
    "allow-apply-model-config",
    "allow-background-main-window",
    "allow-delete-credential",
    "allow-ensure-backend-started",
    "allow-get-backend-connection",
    "allow-get-wake-word-settings",
    "allow-get-credentials",
    "allow-get-installed-tools",
    "allow-get-managed-model-plan",
    "allow-get-tool-ui-source",
    "allow-get-model-config-selection",
    "allow-get-recommended-model-config",
    "allow-install-tool-directory",
    "allow-remove-installed-tool",
    "allow-pause-wake-word",
    "allow-resume-wake-word",
    "allow-save-credential",
    "allow-set-tool-enabled",
    "allow-set-wake-word-enabled",
    "allow-set-wake-word-phrase",
    "allow-set-wake-word-threshold",
    "allow-shutdown-backend",
    "allow-show-whiteboard-window",
    "allow-hide-whiteboard-window",
    "allow-set-whiteboard-window-visible",
    "allow-is-whiteboard-window-visible",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "dialog:allow-open"
  ]
}
