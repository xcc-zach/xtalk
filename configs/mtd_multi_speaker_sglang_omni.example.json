{
  "speaker_diarization": {
    "type": "OfficialMtdClient",
    "params": {
      "base_url": "http://127.0.0.1:18714",
      "request_timeout_s": 15.0,
      "temperature": 0.0,
      "max_tokens": 2048
    }
  },
  "service_config": {
    "multi_speaker": {
      "enabled": true,
      "response_policy": "all",
      "focus_speaker_ids": [],
      "suppress_when_speaker_missing": false,
      "join_timeout_s": 5.0,
      "fallback_on_timeout": true,
      "diarization": {
        "sample_rate": 16000,
        "pre_buffer_s": 1.0,
        "partial": {
          "interval_s": 1.0,
          "first_partial_min_s": 0.8,
          "publish_unchanged": false,
          "abort_on_vad_end": true
        }
      }
    }
  }
}
